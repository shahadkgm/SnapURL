# SnapURL — Docker Environment
# Copy this file to .env and fill in your secrets.
# Used by docker-compose.yml

# ─── Backend ──────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
BASE_URL=http://localhost:3000

# Set this to your Vercel domain in production or http://localhost when running locally
FRONTEND_URL=http://localhost

# ─── Frontend Build Arg ───────────────────────────
# Must be the URL the BROWSER will use to reach the API.
# In local Docker: http://localhost:3000
# In production:   https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:3000
