# SnapURL — Docker Environment Configuration
# Copy this file to .env before starting Docker Compose
PORT=3000
DATABASE_URL=mongodb://mongo:27017/snapurl
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost

# Frontend Build Arg (URL the user's browser uses to reach the API)
VITE_API_BASE_URL=http://localhost:3000

